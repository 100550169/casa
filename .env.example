# =========================================================
#  Environment variables — Casa
#  Copy this file to .env and fill in the real values.
#  NEVER commit a .env file with real values.
#
#  The app has no accounts and sends no email, so the list is short.
#  Only DATABASE_URL is required.
# =========================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL database (Neon, Supabase, local…) ---
# Required: the household's state lives here. Without it, the app starts but
# cannot save anything (the /demo route still works).
DATABASE_URL=

# --- House code ---
# The household's key: without it, the API does not answer. Each phone receives
# it once (through a link or by typing it) and remembers it. Generate one with:
#   npm run codigo
# Strongly recommended on any deployment reachable from the Internet: if left
# empty, anyone who knows the address can get in. Leave it empty only locally.
# Set the same value as the CODIGO_CASA secret on GitHub (backup and reminder).
# Guide: docs/DEPLOY-ON-RENDER.md
CODIGO_CASA=

# --- Phone notifications (optional) ---
# If left empty, the keys are generated on first start and stored in the
# database. VAPID_SUBJECT is the contact shown to Apple/Google; on Render the
# service address is used by default.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Household time zone ---
# Decides when the week starts and the month changes. It follows the SERVER
# clock, not each phone's: a device with the wrong date cannot reset the month
# for everyone.
TZ_FAMILIA=Europe/Madrid

# --- Android app (TWA) ---
# Only needed when publishing the app on Google Play. Play Console gives you
# the SHA-256 fingerprint after the first upload.
ANDROID_FINGERPRINT=
ANDROID_PACKAGE=com.casa.tareas
